{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "bin\\Build.exe",
            "args": [
                "GameBuild/build.conf"
            ],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "close": false
            }
        },
        {
            "label": "hot_reload",
            "type": "shell",
            "command": "bin\\Build.exe",
            "args": [
                "GameBuild/build.conf",
                "-hot"
            ],
            "group": "build",
            "presentation": {
                "close": true
            }
        }
    ]
}