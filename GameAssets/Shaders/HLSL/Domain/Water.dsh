Texture2D Texture: register(t0);
SamplerState Sampler: register(s0);

cbuffer Globals: register(b0) {
    float4x4 Projection;
    float4x4 View;
    float2 Resolution;
    float2 Mouse;
    float2 LastMouse;
    float Time;
};

cbuffer Transforms: register(b3) {
    float4x4 Model;
    float4x4 Normal;
};

cbuffer Sea: register(b9) {
    float3 Dimensions;
    float2 Wind;
};

struct HS_OUT {
    float3 Position: POSITION;
};

struct DS_OUT {
    float4 OutPosition: SV_POSITION;
    float3 Position: POSITION;
    float2 Texture: TEXCOORD0;
};

struct CONSTANT_OUTPUT {
    float Edges[4]: SV_TessFactor;
    float Inside[2]: SV_InsideTessFactor;
};

[domain("quad")]
DS_OUT main(
    CONSTANT_OUTPUT ConstantPatch,
    float2 UV: SV_DomainLocation,
    const OutputPatch<HS_OUT, 4> Patch
) {
    DS_OUT Result;

    float u = UV.x;
    float v = UV.y;

    float3 P00 = Patch[0].Position;
    float3 P01 = Patch[1].Position;
    float3 P10 = Patch[2].Position;
    float3 P11 = Patch[3].Position;

    float3 P0 = lerp(P01, P00, u);
    float3 P1 = lerp(P11, P10, u);
    float3 P  = lerp(P0,  P1, v);

    float2 L = float2(10, 10);
    float X = P.x;
    float Z = P.z;

    float H = Texture.SampleLevel(Sampler, P.xz, 0).r;
    float Y = H;

    P = float3(X,Y,Z);

    float4 WorldPosition = mul(float4(P, 1.0f), Model);

    Result.OutPosition = mul(mul(WorldPosition, View), Projection);
    Result.Position = WorldPosition.xyz;
    Result.Texture = P.xz;
    return Result;
}