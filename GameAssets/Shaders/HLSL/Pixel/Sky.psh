cbuffer Light: register(b1) {
	float3 LightDirection;
	float3 LightColor;
	float3 CameraPosition;
	float Ambient;
	float Diffuse;
};

struct VS_OUT {
    float4 Position: SV_POSITION;
    float3 WorldPosition: TEXCOORD;
};

float4 main(VS_OUT vout): SV_TARGET {
    float3 V = normalize(vout.WorldPosition);

    float3 Color = float3(0,0,0);

    float t = smoothstep(-0.5, 0.5, V.y);
    float3 NightColor = float3(0.02, 0.02, 0.04);
    float3 Gray = float3(0.1, 0.1, 0.1);

    Color = smoothstep(-0.1, 0.1, V.y) * (t * NightColor + (1 - t) * Gray);

    return float4(Color, 1.0);
}
