static const float Tau = 6.28318530718f; // 2*Pi

Texture2D Texture: register(t0);

cbuffer Sea: register(b9) {
    float3 Dimensions;
    float2 Wind;
};

struct VS_OUT {
    float4 Position: SV_POSITION;
    float2 Texture: TEXCOORD0;
};

float4 main(VS_OUT vout): SV_Target {
    uint x = uint(vout.Texture.x*1024.0f);
    uint y = uint(vout.Texture.y*1024.0f);

    float dx = 1024.0f / Dimensions.x;
    float dz = 1024.0f / Dimensions.y;

    float2 P = float2(ThreadID.xy);
    float2 k = normalize((P - 512.0f) / float2(dx, dz));

    int2 Index = int2(x, y);
    float2 z = Texture[Index];

    float2 Displacement_x = k.x * float2(-z.y, z.x);
    float2 Displacement_y = k.y * float2(-z.y, z.x);

    return float4(Displacement_x, Displacement_y);
}