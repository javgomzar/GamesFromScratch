cbuffer Color: register(b2) {
    float4 Color;
};

struct VS_OUTPUT {
    float4 Position: SV_POSITION;
    sample float2 Barycentric: TEXCOORD;
};

float4 main(VS_OUTPUT vout, uint SampleIndex: SV_SAMPLEINDEX): SV_TARGET {
    float f = 0.5 * vout.Barycentric.x + vout.Barycentric.y;
    float s = smoothstep(-0.01, 0.01, f*f - vout.Barycentric.y);
    return s * Color;
}