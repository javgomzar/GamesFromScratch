static const float Tau = 6.28318530718f; // 2*Pi

Texture2D Texture: register(t0);

cbuffer FFT: register(b10) {
    uint N;
    uint Direction;
    uint Stage;
};

struct VS_OUT {
    float4 Position: SV_POSITION;
    float2 Texture: TEXCOORD0;
};

float2 ComplexMul(float2 z, float2 w) {
    return float2(z.x * w.x - z.y * w.y, z.x * w.y + z.y * w.x);
}

float2 GetTwiddle(float Angle) {
    return float2(cos(Angle), sin(Angle));
}

float4 main(VS_OUT vout): SV_Target {
    uint x = uint(vout.Texture.x*1024.0f);
    uint y = uint(vout.Texture.y*1024.0f);

    uint StageHalfSize = 1 << Stage;
    uint StageSize = StageHalfSize << 1;

    uint Index = Direction ? y : x;

    uint Base = (Index / StageSize) * StageHalfSize;
    uint Offset = Index % StageHalfSize;

    int2 Input0 = Direction ? int2(x, Base + Offset) : int2(Base + Offset, y);
    int2 Input1 = Direction ? int2(x, Base + Offset + (N >> 1)) : int2(Base + Offset + (N >> 1), y);

    float2 z0 = Texture[Input0];
    float2 z1 = Texture[Input1];

    float2 t = GetTwiddle(Tau * float(Index) / StageSize);

    return float4(z0 + ComplexMul(t, z1), 0.0f, 1.0f);
}