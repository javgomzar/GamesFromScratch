Texture2D Texture: register(t0);
SamplerState Sampler: register(s0);

cbuffer Light: register(b1) {
	float3 LightDirection;
	float3 LightColor;
	float3 CameraPosition;
	float Ambient;
	float Diffuse;
};

cbuffer Color: register(b2) {
    float4 Color;
};

struct VertexOut {
    float4 Position: SV_POSITION;
    float3 WorldPosition: TEXCOORD1;
    float2 Texture: TEXCOORD;
    float3 Normal: NORMAL;
};

float4 main(VertexOut vout): SV_TARGET {
    float4 Sample = Texture.Sample(Sampler, float2(vout.Texture.x, vout.Texture.y));
    float3 Normal = normalize(vout.Normal);
    float Diff = Diffuse * max(dot(Normal, -LightDirection), 0);
    // float3 ViewDirection = normalize(CameraPosition - vout.WorldPosition.xyz);
    // float3 Reflection = reflect(LightDirection, Normal);
    // float Spec = pow(max(dot(ViewDirection, Reflection), 0.0), 8);

    // float3 Result = (Ambient + Diff) * Sample.rgb * Color.rgb + Spec * LightColor;
    float3 Result = (Ambient + Diff) * Sample.rgb * Color.rgb;

    return float4(Result, 1.0);
}
